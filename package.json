{
	"name": "clean-elysia-prisma",
	"version": "1.0.50",
	"scripts": {
		"test": "echo \"Error: no test specified\" && exit 1",
		"dev": "bun run --watch src/index.ts",
		"build": "bun build \t--target bun \t--minify-whitespace \t--minify-syntax \t--outfile ./dist/index.js \tsrc/index.ts",
		"build:binary": "bun build \t--compile \t--minify-whitespace \t--minify-syntax \t--target bun \t--outfile server \tsrc/index.ts",
		"start": "bun run dist/index.js",
		"start:binary": "./server",
		"lint": "eslint . --ext .ts",
		"lint:fix": "eslint . --ext .ts --fix",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"typecheck": "bun run tsc --noEmit",
		"db:seed": "bun ./prisma/seed/index.ts",
		"i18n:keys": "bun ./src/libs/i18n/scripts/generate-keys.ts",
		"husky": "husky install",
		"prepare": "husky",
		"db:clickhouse:migrate": "bun run ./src/libs/database/clickhouse/scripts/migrate.ts migrate",
		"db:clickhouse:status": "bun run ./src/libs/database/clickhouse/scripts/migrate.ts status"
	},
	"dependencies": {
		"@bogeychan/elysia-logger": "^0.1.10",
		"@clickhouse/client": "^1.24.1",
		"@elysiajs/bearer": "^1.4.4",
		"@elysiajs/cors": "^1.4.2",
		"@elysiajs/jwt": "^1.4.2",
		"@elysiajs/openapi": "^1.4.16",
		"@eslint/js": "^10.0.1",
		"@prisma/adapter-pg": "7.10.1",
		"@prisma/client": "7.10.1",
		"bcryptjs": "^3.0.3",
		"bullmq": "^6.5.3",
		"crypto-js": "^4.2.0",
		"dayjs": "^1.11.23",
		"dotenv": "^18.0.9",
		"elysia": "^1.4.30",
		"elysia-helmet": "^3.1.0",
		"elysia-rate-limit": "^4.6.3",
		"envalid": "^9.0.0",
		"ioredis": "^6.0.0",
		"nodemailer": "^10.3.1",
		"pg": "^8.23.1",
		"pino": "^10.4.0",
		"pino-pretty": "^13.2.0"
	},
	"devDependencies": {
		"@types/crypto-js": "^4.2.2",
		"@types/nodemailer": "^8.0.2",
		"@typescript-eslint/eslint-plugin": "^8.72.1",
		"@typescript-eslint/parser": "^8.72.1",
		"bun-types": "^1.4.4",
		"eslint": "^10.14.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-import": "^2.32.0",
		"eslint-plugin-prettier": "^5.5.7",
		"eslint-plugin-simple-import-sort": "^14.0.0",
		"globals": "^17.13.0",
		"husky": "^9.1.7",
		"prisma": "7.10.1",
		"typescript-eslint": "^8.72.1"
	},
	"peerDependencies": {
		"typescript": "^6.0.3"
	},
	"module": "src/index.js"
}
